generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  username             String?   @unique
  password             String
  createdAt            DateTime  @default(now())
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  timezone             String    @default("UTC")
  totalQuestsCompleted Int       @default(0) @map("totalTasksCompleted")
  maxStreak            Int       @default(0)
  emailReminders         Boolean   @default(true)
  bio                    String?
  avatar                 String?
  coins                  Int       @default(0)
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?
  loginAttempts          Int       @default(0)
  lockedUntil            DateTime?

  xp                    Int       @default(0)
  level                 Int       @default(1)

  streakShieldActive    Boolean   @default(false)
  debtFreezeUntil       DateTime?
  payoffMultiplierActive Boolean  @default(false) @map("pushupMultiplierActive")
  profileFlair          String?

  // --- audit fixes (2026-10) ---
  tokenVersion          Int       @default(0)   // bumped on password change/reset to revoke old JWTs
  streakShieldDate      DateTime?               // the local day a Streak Shield protected (persisted)
  currentStreak         Int       @default(0)   // cached; recomputed on completion + nightly
  pausedUntil           DateTime?               // pause mode: no debt accrues until this time
  lastPauseAt           DateTime?               // pause quota tracking
  lastFreshStartAt      DateTime?               // Fresh Start quota tracking
  pushReminders         Boolean   @default(true) // independent of emailReminders
  allowChaos            Boolean   @default(true) // receive Debt Bombs / taunts from friends
  invitedById           Int?
  lastActiveAt          DateTime?

  quests             Quest[]
  payoffSessions     PayoffSession[]
  debts              Debt[]
  sentRequests       Friendship[]       @relation("SentRequests")
  receivedRequests   Friendship[]       @relation("ReceivedRequests")
  challengesGiven    Challenge[]        @relation("ChallengesGiven")
  challengesReceived Challenge[]        @relation("ChallengesReceived")
  pushSubscriptions  PushSubscription[]
  deviceTokens       DeviceToken[]
  inventory          UserItem[]
  appNotifications   AppNotification[]
  questCompletions   QuestCompletion[]
}

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model Challenge {
  id           Int       @id @default(autoincrement())
  challengerId Int
  challengedId Int
  type         String
  durationDays Int
  status       String    @default("pending")
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  challengerScore Int?    // frozen when the challenge ends
  challengedScore Int?

  challenger User @relation("ChallengesGiven", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged User @relation("ChallengesReceived", fields: [challengedId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([challengedId])
}

// Mapped to the legacy "Task" table — physical DB names unchanged by the
// PushupDebt → SideQuest rebrand so no data migration is required.
model Quest {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  completed   Boolean   @default(false)
  recurrence  String    @default("none")
  createdAt   DateTime  @default(now())
  dueDate     DateTime
  completedAt DateTime?
  deletedAt   DateTime?
  userId      Int

  category    String    @default("other")
  difficulty  String    @default("medium")
  xpReward    Int       @default(50)
  debtType    String    @default("pushups")
  debtAmount  Int       @default(5)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt Debt?
  completions QuestCompletion[]

  @@index([userId, deletedAt])
  @@index([dueDate])
  @@index([completedAt])
  @@map("Task")
}

// Mapped to the legacy "PushupDebt" table.
model Debt {
  id              Int      @id @default(autoincrement())
  questId         Int?     @unique @map("taskId")
  userId          Int
  amountOwed      Float    @map("pushupsOwed")
  daysOverdue     Int
  frozenDays      Int      @default(0)        // overdue days skipped by Debt Freeze / pause (never charged)
  source          String   @default("quest")  // quest | delete | bomb  (bombs don't count toward the lockout)
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quest Quest? @relation(fields: [questId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resolved])
  @@map("PushupDebt")
}

// Mapped to the legacy "PushupSession" table.
model PayoffSession {
  id       Int      @id @default(autoincrement())
  amount   Int      @map("pushupsCompleted")
  activity String   @default("fitness") // fitness | focus | wellness | chores | custom
  coinsEarned Int   @default(0)         // for the daily surplus-coin cap
  date     DateTime @default(now())
  userId   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("PushupSession")
}

model UserItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// In-app popup events (taunts, debt bombs). Written at purchase time so the
// target sees a popup on their next app open even if the push never lands.
model AppNotification {
  id           Int      @id @default(autoincrement())
  userId       Int
  type         String   // taunt | debt_bomb
  message      String
  fromUsername String?
  seen         Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seen])
}

// Native iOS APNs device tokens (the web uses PushSubscription/VAPID instead).
model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per quest per local day it was completed. Streaks and recurring-quest
// history are computed from this instead of Quest.dueDate (which moves forward
// every day for recurring quests).
model QuestCompletion {
  id          Int      @id @default(autoincrement())
  questId     Int?
  userId      Int
  localDate   String   // YYYY-MM-DD in the user's timezone
  completedAt DateTime @default(now())

  quest Quest? @relation(fields: [questId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, localDate])
  @@index([userId, localDate])
}

// Idempotency ledger for cron jobs and one-off sends (e.g. "winback7:<userId>").
model JobRun {
  id        Int      @id @default(autoincrement())
  name      String
  runKey    String
  createdAt DateTime @default(now())

  @@unique([name, runKey])
}
